@echo off
rem Renders every intro line with Piper into voices\intro (one wav per line).
cd /d "%~dp0"
set P=%~dp0voices\piper
set O=%~dp0voices\intro
if not exist "%O%" mkdir "%O%"
echo Date night with Mirabel. Seven o'clock. Candles, roses, my good hat...| "%P%\piper\piper.exe" -q -m "%P%\en_GB-alan-medium.onnx" -s 0 --length_scale 1.189 --noise_scale 0.75 --noise_w 0.9 --sentence_silence 0.15 -f "%O%\f01.wav"
echo ...and three hundred years of laundry. Oh dear. Oh dear, oh dear.| "%P%\piper\piper.exe" -q -m "%P%\en_GB-alan-medium.onnx" -s 0 --length_scale 1.130 --noise_scale 0.8 --noise_w 0.9 --sentence_silence 0.15 -f "%O%\f02.wav"
